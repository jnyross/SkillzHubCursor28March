{
  "name": "skill-builder-webapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.32.1"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck:shared": "pnpm --filter @skill-builder/shared typecheck",
    "typecheck": "pnpm run typecheck:shared && turbo run typecheck --filter=!@skill-builder/shared",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:web": "pnpm --filter web dev",
    "dev:worker": "pnpm --filter worker dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:up:host": "node scripts/host-infra-up.mjs",
    "infra:down:host": "node scripts/host-infra-down.mjs",
    "db:up": "pnpm infra:up",
    "db:down": "pnpm infra:down",
    "db:reset": "pnpm infra:reset",
    "claude:smoke": "claude --version",
    "claude:preflight": "node scripts/claude-preflight.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^20.19.17",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.21.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
